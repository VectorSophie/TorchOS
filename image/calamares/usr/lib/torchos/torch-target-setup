#!/usr/bin/bash
# Runs inside the freshly unpacked target (chroot) as a Calamares shellprocess.
# Turns the copied live rootfs into an installed system. Log: /var/log/torchos-install.log
# Steps are ordered so a failure in a nice-to-have (snapper, grub-btrfs) never blocks boot.
exec > >(tee -a /var/log/torchos-install.log) 2>&1
set -x

## 1. Remove everything that only exists for the live session.
rm -f /usr/lib/sysusers.d/torch-live.conf /etc/sudoers.d/99-torch-live \
      /etc/systemd/system/getty@tty1.service.d/autologin.conf \
      /etc/systemd/system/multi-user.target.wants/torch-live-setup.service \
      /etc/systemd/system/torch-live-setup.service \
      /usr/local/bin/torch-live-setup /usr/local/bin/calamares-launch /etc/profile.d/torchos-hyprland.sh \
      /etc/mkinitcpio.conf.d/archiso.conf /etc/hostname.live
rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
rm -rf /home/liveuser
userdel liveuser 2>/dev/null || true   # account can exist in the copied passwd/shadow/group
groupdel liveuser 2>/dev/null || true
rm -f /etc/systemd/system/pacman-init.service /etc/systemd/system/etc-pacman.d-gnupg.mount \
      /etc/systemd/system/multi-user.target.wants/pacman-init.service
# The live image masks firstboot (no interactive prompt); the installed system does not need it either
# (Calamares sets locale/timezone/machine-id), but leave it unmasked so it is not silently disabled.
rm -f /etc/systemd/system/systemd-firstboot.service
# Live-only mask (systemd#43605: systemd-loop@sr0 fails on archiso optical boots); installed systems keep it.
rm -f /etc/systemd/system/systemd-loop@.service

## 2. Normal initramfs (the live one boots through archiso hooks) for every installed kernel.
for d in /usr/lib/modules/*/; do
  base=$(cat "$d/pkgbase" 2>/dev/null) || continue
  # Calamares unpacks with `rsync -S`, which turns the kernel's trailing zero padding into a hole at
  # EOF. Linux reads that fine but GRUB's btrfs driver stops at the last real extent ("premature end
  # of file"). Copy densely, no reflink, so the tail is real data. Verified with grub-fstest.
  if [ -f "$d/vmlinuz" ]; then
    cp --sparse=never --reflink=never "$d/vmlinuz" "/boot/vmlinuz-$base" && chmod 644 "/boot/vmlinuz-$base"
    cmp -s "$d/vmlinuz" "/boot/vmlinuz-$base" || echo "ERROR: /boot/vmlinuz-$base differs from source"
  fi
  cat > "/etc/mkinitcpio.d/$base.preset" <<PRESET
ALL_kver="/boot/vmlinuz-$base"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-$base.img"
fallback_image="/boot/initramfs-$base-fallback.img"
fallback_options="-S autodetect"
PRESET
done
# busybox init + grub-btrfs-overlayfs: booting a read-only snapshot from the GRUB menu gets a
# writable overlay (changes vanish on reboot) instead of a half-working read-only root. The hook is a
# runtime busybox hook; Arch's default systemd-based initramfs never runs it.
echo 'HOOKS=(base udev autodetect microcode modconf kms keyboard keymap block filesystems fsck grub-btrfs-overlayfs)' \
  > /etc/mkinitcpio.conf.d/torchos.conf
# The installer and live-ISO tooling have no job on an installed system. Removing mkinitcpio-archiso
# fires pacman's mkinitcpio hook, which builds every preset above: that *is* the initramfs build
# (a separate `mkinitcpio -P` doubled install time by ~3 min). This script belongs to
# torch-installer-config; bash already has it open, so removing it mid-run is safe.
if ! pacman -Rns --noconfirm calamares torch-installer-config archiso mkinitcpio-archiso; then
  echo "WARN: could not remove installer packages"
  mkinitcpio -P || echo "WARN: mkinitcpio -P failed"
fi

## 3. Keyring + TorchOS package repo, zram, login, services.
pacman-key --init && pacman-key --populate archlinux
pacman-key --populate torchos || echo "WARN: torchos keyring missing: torch-* updates will fail signature checks"
# Hosted, signed repo so torch-* packages update like everything else (image/scripts/publish-repo.sh).
grep -q '^\[torchos\]' /etc/pacman.conf ||
  printf '\n[torchos]\nServer = https://github.com/VectorSophie/TorchOS/releases/download/repo\n' >> /etc/pacman.conf
# Login: greetd + tuigreet (text greeter, remembers the last user/session) instead of tty autologin.
mkdir -p /etc/greetd
cat > /etc/greetd/config.toml <<'GREETD'
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-user-session --asterisks --greeting 'Welcome to TorchOS' --cmd start-hyprland"
user = "greeter"
GREETD
mkdir -p /etc/systemd
printf '[zram0]\nzram-size = ram / 2\ncompression-algorithm = zstd\n' > /etc/systemd/zram-generator.conf
for u in NetworkManager.service bluetooth.service torchd.service power-profiles-daemon.service \
         systemd-timesyncd.service fstrim.timer cups.socket \
         snapper-timeline.timer snapper-cleanup.timer grub-btrfsd.service greetd.service; do
  systemctl enable "$u" || echo "WARN: could not enable $u"
done

## 4. Snapper on the root Btrfs (skipped cleanly on non-Btrfs roots) + the first checkpoint,
##    taken *before* grub-mkconfig so grub-btrfs sees it.
##    Layout: snapshots live in the separate @snapshots subvolume mounted at /.snapshots (already in
##    fstab from Calamares), NOT nested in @, so swapping @ during a rollback never loses them.
##    snapper create-config refuses an existing /.snapshots and makes its own nested subvolume, so:
##    unmount ours, let snapper create, delete the nested one, remount ours.
if [ "$(findmnt -no FSTYPE /)" = btrfs ] && grep -q '/.snapshots' /etc/fstab; then
  umount /.snapshots 2>/dev/null; rmdir /.snapshots 2>/dev/null
  if snapper --no-dbus -c root create-config /; then
    btrfs subvolume delete /.snapshots
    mkdir -p /.snapshots && chmod 750 /.snapshots
    mount /.snapshots || echo "ERROR: could not mount /.snapshots"
    snapper --no-dbus -c root set-config TIMELINE_CREATE=no NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=6 \
        ALLOW_GROUPS=wheel SYNC_ACL=yes
    snapper --no-dbus -c root create -d "TorchOS fresh install" -u important=yes
  else
    echo "WARN: snapper create-config failed"
  fi
fi

## 5. Development ISOs only (build-iso.sh with DEV_SSH_PUBKEY): keep sshd + serial console for testing.
if [ -f /etc/torch-dev-build ]; then
  systemctl enable sshd.service
  for h in /home/*/; do
    u=$(basename "$h"); mkdir -p "$h.ssh"; cp /etc/ssh/dev_authorized_keys "$h.ssh/authorized_keys"
    chown -R "$u:$u" "$h.ssh"; chmod 700 "$h.ssh"; chmod 600 "$h.ssh/authorized_keys"
  done
  sed -i 's/^GRUB_CMDLINE_LINUX=.*/GRUB_CMDLINE_LINUX="console=ttyS0,115200 console=tty0"/' /etc/default/grub
fi
exit 0
